      document.getElementById("editorProjectSelect").value = projectId;
      loadProjectIntoEditor();
    }

    function clearEditor() {
      document.getElementById("editorProjectSelect").value = "";
      document.getElementById("editorProjectName").value = "";
      document.getElementById("editorMainPy").value = "";
      document.getElementById("editorReqTxt").value = DEFAULT_REQUIREMENTS;
      activeLine = 1;
      renderEditor(false);
    }

    function insertMiniAppTemplate() {
      document.getElementById("editorReqTxt").value = DEFAULT_REQUIREMENTS;
      document.getElementById("editorMainPy").value = `from flask import Flask, render_template_string

