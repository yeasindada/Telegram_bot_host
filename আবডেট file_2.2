    async function saveEditorProject(autoStart) {
      if (!currentUser) return;
      const existingId = document.getElementById("editorProjectSelect").value;
      const name = document.getElementById("editorProjectName").value.trim() || "my_bot";
      const mainCode = document.getElementById("editorMainPy").value;
      const reqCode = document.getElementById("editorReqTxt").value.trim() || DEFAULT_REQUIREMENTS;

      if (!mainCode.trim()) {
        return showToast("main.py কোড খালি রাখা যাবে না!");
      }

      const files = {
        file_000: { name: "main.py", content: mainCode },
        file_001: { name: "requirements.txt", content: reqCode }
      };

      const projRef = existingId
        ? db.ref(`projects/${currentUser.uid}/${existingId}`)
        : db.ref(`projects/${currentUser.uid}`).push();

      const payload = {
        name: name,
        files: files,
        updatedAt: firebase.database.ServerValue.TIMESTAMP
      };
      if (!existingId) {
        payload.status = "STOPPED";
        payload.liveUrl = "";
        payload.createdAt = firebase.database.ServerValue.TIMESTAMP;
      }

      await projRef.update(payload);

      const savedId = projRef.key;
      showToast("প্রজেক্ট সেভ হয়েছে!");

      if (autoStart) {
        await sendBotCommand(savedId, "start", true);
        switchTab("dashboard");
      }
    }

    async function uploadProjectFiles() {
      if (!currentUser) return;
      const name = document.getElementById("uploadProjectName").value.trim() || "bot";
      const fileInput = document.getElementById("uploadFilesInput");
      const fileList = Array.from(fileInput.files || []);

      if (!fileList.length) return showToast("ফাইল নির্বাচন করুন");

      const filesObj = {};
      let hasMain = false;
      let hasReq = false;

      for (let i = 0; i < fileList.length; i++) {
        const f = fileList[i];
        if (f.name === "main.py") hasMain = true;
        if (f.name === "requirements.txt") hasReq = true;
        const text = await f.text();
        const key = "file_" + String(i).padStart(3, "0");
        filesObj[key] = { name: f.name, content: text };
      }

      if (!hasMain) return showToast("ফাইলগুলোর মধ্যে main.py থাকতে হবে!");

      if (!hasReq) {
        const nextKey = "file_" + String(fileList.length).padStart(3, "0");
        filesObj[nextKey] = { name: "requirements.txt", content: DEFAULT_REQUIREMENTS };
      }

      const projRef = db.ref(`projects/${currentUser.uid}`).push();
      await projRef.set({
        name: name,
        status: "STOPPED",
        liveUrl: "",
        files: filesObj,
        createdAt: firebase.database.ServerValue.TIMESTAMP
      });

      fileInput.value = "";
      document.getElementById("uploadProjectName").value = "";
      showToast("ফাইল আপলোড সম্পন্ন হয়েছে!");
      switchTab("dashboard");
    }

    async function sendBotCommand(projectId, action, alsoOpenTermux = false) {
      if (!currentUser) return;

      if (action === "stop") {
        await db.ref(`projects/${currentUser.uid}/${projectId}`).update({
          status: "STOPPED",
          liveUrl: "",
          updatedAt: firebase.database.ServerValue.TIMESTAMP
        });
      }

      await db.ref(`botCommands/${currentUser.uid}/${projectId}`).push({
        action: action,
        requestedAt: firebase.database.ServerValue.TIMESTAMP
      });

      showToast(action.toUpperCase() + " কমান্ড পাঠানো হয়েছে...");

      if (action === "start" && alsoOpenTermux) {
        const cmd = getWorkerSetupCommand();
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(cmd).catch(() => {});
        }
        setTimeout(() => {
          openTermuxOnly();
        }, 450);
      }
    }

    async function deleteProject(projectId) {
      if (!currentUser) return;
      if (!confirm("প্রজেক্টটি ডিলিট করতে চান?")) return;
      await db.ref(`projects/${currentUser.uid}/${projectId}`).remove();
      showToast("প্রজেক্ট ডিলিট হয়েছে");
    }

    function copyText(text) {
      navigator.clipboard.writeText(text)
        .then(() => showToast("লিংক কপি হয়েছে!"))
        .catch(() => showToast("কপি করা যায়নি"));
    }

    function escapeHtml(str) {
      return String(str)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    }
  </script>
</body>
</html>
