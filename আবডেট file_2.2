    function renderEditor(recalcCursor = true) {
      const ta = document.getElementById("editorMainPy");
      const gutter = document.getElementById("edGutter");
      const highlight = document.getElementById("edHighlight");
      const lineStatus = document.getElementById("edLineStatus");
      const errStatus = document.getElementById("edErrorStatus");
      if (!ta || !gutter || !highlight) return;

      if (recalcCursor) {
        const pos = ta.selectionStart || 0;
        activeLine = ta.value.slice(0, pos).split("\n").length;
      }

      const code = ta.value;
      const lines = code.split("\n");
      const count = Math.max(lines.length, 1);
      const errLines = findErrorLines(code);

      let gutterHtml = "";
      let codeHtml = "";

      for (let i = 1; i <= count; i++) {
        const isErr = errLines.has(i);
        const isCur = i === activeLine;
        const lnClass = isErr ? "ed-ln err" : (isCur ? "ed-ln active" : "ed-ln");
        gutterHtml += `<div class="${lnClass}">${i}</div>`;

        const raw = lines[i - 1] || "";
        const safe = raw.length ? escapeHtml(raw) : " ";
        codeHtml += `<span class="ed-line ${isErr ? "err-text" : ""}">${safe}</span>`;
      }

      gutter.innerHTML = gutterHtml;
      highlight.innerHTML = codeHtml;

      if (lineStatus) {
        lineStatus.textContent = `Line ${activeLine} / ${count}`;
      }

      if (errStatus) {
        if (errLines.size > 0) {
          const sorted = Array.from(errLines).sort((a, b) => a - b).join(", ");
          errStatus.className = "meta-err-list has-err";
          errStatus.textContent = `ভুল Line: ${sorted}`;
        } else {
          errStatus.className = "meta-err-list";
          errStatus.textContent = "ভুল নেই";
        }
      }

      syncScroll();
    }

