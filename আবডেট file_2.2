<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>BOT HOSTING PRO • Black & Gold Edition</title>
  <style>
    :root {
      --bg: #090806;
      --card: #12100c;
      --card-2: #18140e;
      --border: #3a2e1a;
      --gold: #d4af37;
      --gold-light: #f3d576;
      --text: #f5efe2;
      --muted: #a69982;
      --red: #ff6b68;
      --green: #38c172;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    body {
      background: radial-gradient(circle at top, #1b150b 0%, var(--bg) 55%);
      color: var(--text);
      min-height: 100vh;
      padding: 14px;
    }

    .app-wrap {
      max-width: 540px;
      margin: 0 auto;
      padding-bottom: 30px;
    }

    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 14px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .logo {
      width: 42px;
      height: 42px;
      border-radius: 12px;
      background: linear-gradient(145deg, #c69c2b, #6f5212);
      color: #0b0906;
      font-weight: 900;
      font-size: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 14px rgba(212, 175, 55, 0.25);
    }

    .brand h1 {
      font-size: 16px;
      letter-spacing: 0.6px;
      color: var(--gold-light);
    }

    .brand p {
      font-size: 10px;
      color: var(--muted);
      letter-spacing: 0.7px;
      margin-top: 2px;
    }

    .badge-edition {
      border: 1px solid var(--border);
      background: var(--card);
      color: var(--gold-light);
      font-size: 10px;
      padding: 6px 10px;
      border-radius: 999px;
      letter-spacing: 0.5px;
    }

    .card {
      background: linear-gradient(180deg, var(--card-2), var(--card));
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 15px;
      margin-bottom: 12px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
    }

    .hero h2 {
      font-size: 20px;
      color: var(--text);
      margin-bottom: 6px;
    }

    .hero p {
      font-size: 12.5px;
      color: var(--muted);
      line-height: 1.5;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      margin-bottom: 12px;
    }

    .stat-box {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 12px;
    }

    .stat-box span {
      display: block;
      font-size: 10px;
      color: var(--muted);
      letter-spacing: 0.6px;
      margin-bottom: 5px;
    }

    .stat-box strong {
      font-size: 18px;
      color: var(--gold-light);
    }

    .nav-tabs {
      display: flex;
      gap: 7px;
      overflow-x: auto;
      padding-bottom: 4px;
      margin-bottom: 12px;
      scrollbar-width: none;
    }

    .nav-tabs::-webkit-scrollbar {
      display: none;
    }

    .tab-btn {
      flex: 0 0 auto;
      padding: 9px 14px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: var(--card);
      color: var(--text);
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
    }

    .tab-btn.active {
      background: linear-gradient(135deg, #c69c2b, #8b6914);
      color: #0c0905;
      border-color: var(--gold-light);
    }

    .section-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
    }

    .section-head h3 {
      font-size: 13px;
      color: var(--gold-light);
      letter-spacing: 0.5px;
    }

    .section-head span {
      font-size: 11px;
      color: var(--muted);
    }

    .project-card {
      background: #0e0c09;
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 13px;
      margin-bottom: 10px;
    }

    .proj-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 10px;
    }

    .proj-title {
      font-size: 15px;
      font-weight: 700;
      color: var(--text);
    }

    .proj-sub {
      font-size: 11px;
      color: var(--muted);
      margin-top: 2px;
    }

    .status-pill {
      font-size: 10px;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: rgba(255, 255, 255, 0.04);
      color: var(--muted);
    }

    .status-pill.RUNNING {
      color: #5ee394;
      border-color: rgba(56, 193, 114, 0.45);
      background: rgba(56, 193, 114, 0.14);
    }

    .status-pill.ERROR {
      color: #ff8a88;
      border-color: rgba(227, 93, 91, 0.45);
      background: rgba(227, 93, 91, 0.14);
    }

    .btn-row {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-bottom: 10px;
    }

    .btn {
      border: 1px solid var(--border);
      background: var(--card-2);
      color: var(--text);
      font-size: 11px;
      font-weight: 700;
      padding: 8px 11px;
      border-radius: 10px;
      cursor: pointer;
    }

    .btn:active {
      transform: scale(0.98);
    }

    .btn-gold {
      background: linear-gradient(135deg, #c69c2b, #8b6914);
      color: #0d0a06;
      border-color: var(--gold-light);
    }

    .btn-danger {
      background: rgba(227, 93, 91, 0.15);
      color: #ff9c9a;
      border-color: rgba(227, 93, 91, 0.4);
    }

    .live-box {
      background: #14110c;
      border: 1px solid var(--border);
      border-radius: 11px;
      padding: 10px;
    }

    .live-label {
      font-size: 10px;
      color: var(--muted);
      margin-bottom: 4px;
      letter-spacing: 0.5px;
    }

    .live-url {
      display: block;
      font-size: 11.5px;
      color: var(--gold-light);
      word-break: break-all;
      margin-bottom: 8px;
      text-decoration: underline;
    }

    label {
      display: block;
      font-size: 11.5px;
      color: var(--gold-light);
      margin-bottom: 5px;
      margin-top: 10px;
    }

    input[type="text"],
    input[type="email"],
    input[type="password"],
    select,
    textarea {
      width: 100%;
      background: #0c0a07;
      border: 1px solid var(--border);
      border-radius: 11px;
      color: var(--text);
      padding: 10px 12px;
      font-size: 13px;
      outline: none;
    }

    /* Professional Line-Synced Code Editor */
    .pro-editor {
      --ed-font-size: 13px;
      --ed-line-height: 20px;
      --ed-pad-y: 12px;
      --ed-pad-x: 12px;
      --gutter-w: 48px;
      display: flex;
      height: 320px;
      background: #080705;
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      position: relative;
    }

    .ed-gutter {
      width: var(--gutter-w);
      flex: 0 0 var(--gutter-w);
      background: #0d0b08;
      border-right: 1px solid #292012;
      padding-top: var(--ed-pad-y);
      padding-bottom: var(--ed-pad-y);
      overflow: hidden;
      user-select: none;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
      font-size: var(--ed-font-size);
      line-height: var(--ed-line-height);
    }

    .ed-ln {
      height: var(--ed-line-height);
      line-height: var(--ed-line-height);
      padding-right: 8px;
      text-align: right;
      font-size: 11.5px;
      color: #7c705b;
    }

    .ed-ln.active {
      color: var(--gold-light);
      font-weight: 700;
      background: rgba(212, 175, 55, 0.14);
    }

    .ed-ln.err {
      color: var(--red);
      font-weight: 800;
      background: rgba(255, 107, 104, 0.16);
    }

    .ed-viewport {
      position: relative;
      flex: 1;
      height: 100%;
      overflow: hidden;
    }

    .ed-highlight,
    .ed-textarea {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      margin: 0;
      padding: var(--ed-pad-y) var(--ed-pad-x);
      border: none !important;
      border-radius: 0 !important;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
      font-size: var(--ed-font-size);
      line-height: var(--ed-line-height);
      tab-size: 4;
      white-space: pre;
      overflow: auto;
      box-sizing: border-box;
    }

    .ed-highlight {
      color: var(--text);
      background: transparent;
      pointer-events: none;
      z-index: 1;
    }

    .ed-line {
      display: block;
      height: var(--ed-line-height);
      line-height: var(--ed-line-height);
      color: var(--text);
    }

    .ed-line.err-text {
      color: var(--red);
      font-weight: 600;
    }

    .ed-textarea {
      color: transparent !important;
      caret-color: var(--gold-light);
      background: transparent !important;
      resize: none;
      outline: none !important;
      z-index: 2;
    }

    .editor-meta {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 10px;
      margin-top: 7px;
      font-size: 11px;
      color: var(--muted);
    }

    .meta-line-badge {
      flex: 0 0 auto;
      color: var(--gold-light);
      font-weight: 700;
      white-space: nowrap;
    }

    .meta-err-list {
      text-align: right;
      color: #6ee7a0;
      font-weight: 600;
      word-break: break-word;
    }

    .meta-err-list.has-err {
      color: var(--red);
    }

    textarea.req-area {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
      font-size: 12px;
      min-height: 75px;
      background: #080705;
      color: #d7cbb4;
    }

    input[type="file"] {
      width: 100%;
      background: #0c0a07;
      border: 1px dashed var(--border);
      border-radius: 11px;
      padding: 10px;
      color: var(--muted);
      font-size: 12px;
    }

    .code-cmd {
      background: #080705;
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 10px;
      font-family: monospace;
      font-size: 11.5px;
      color: var(--gold-light);
      word-break: break-all;
      margin: 8px 0;
    }

    .quick-helper {
      background: #14110c;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 11px;
      margin-top: 10px;
    }

    .quick-helper p {
      font-size: 11.5px;
      color: var(--muted);
      line-height: 1.5;
      margin-bottom: 8px;
    }

    .toast {
      position: fixed;
      bottom: 18px;
      left: 50%;
      transform: translateX(-50%);
      background: #1f190f;
      border: 1px solid var(--gold);
      color: var(--gold-light);
      padding: 9px 16px;
      border-radius: 999px;
      font-size: 12px;
      z-index: 1200;
      display: none;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.6);
    }

    .hidden {
      display: none !important;
    }

    .footer-note {
      text-align: center;
      font-size: 10.5px;
      color: var(--muted);
      margin-top: 16px;
      letter-spacing: 0.4px;
    }
  </style>
</head>
<body>
  <div class="app-wrap">
    <!-- Top Header -->
    <div class="topbar">
      <div class="brand">
        <div class="logo">B</div>
        <div>
          <h1>BOT HOSTING PRO</h1>
          <p>TELEGRAM BOT CONTROL PANEL</p>
        </div>
      </div>
      <div class="badge-edition">• BLACK &amp; GOLD</div>
    </div>

    <!-- Login / Sign Up View -->
    <div id="authSection" class="card">
      <div class="section-head">
        <h3>ACCOUNT LOGIN / SIGN UP</h3>
        <span>Firebase Auth</span>
      </div>
      <p style="font-size:12px; color:var(--muted); margin-bottom:8px;">
        আপনার Firebase অ্যাকাউন্ট দিয়ে লগইন করুন। Termux Worker-এও এই একই ইমেইল ও পাসওয়ার্ড ব্যবহার করবেন।
      </p>
      <label>Email Address</label>
      <input type="email" id="authEmail" placeholder="example@gmail.com" />
      <label>Password</label>
      <input type="password" id="authPass" placeholder="••••••••" />
      <div class="btn-row" style="margin-top:14px;">
        <button class="btn btn-gold" style="flex:1;" onclick="loginUser()">LOGIN</button>
        <button class="btn" style="flex:1;" onclick="signupUser()">CREATE ACCOUNT</button>
      </div>
    </div>

    <!-- Main App View -->
    <div id="mainApp" class="hidden">
      <div class="card hero">
        <h2>Manage your bots.</h2>
        <p>কোড লিখুন অথবা ফাইল আপলোড করে সেভ করুন, START চাপুন এবং সরাসরি লাইভ লিংক পান।</p>
        <div class="quick-helper">
          <p>
            <strong>সহজ সেটআপ:</strong> START চাপলে সেটআপ কমান্ড কপি হবে এবং Termux খোলার চেষ্টা করবে। Termux-এ কমান্ড পেস্ট করে Enter দিন, তারপর আপনার ইমেইল ও পাসওয়ার্ড দিলে বট চালু হয়ে লাইভ লিংক চলে আসবে।
          </p>
          <div class="btn-row" style="margin-bottom:0;">
            <button class="btn btn-gold" onclick="copySetupAndOpenTermux()">COPY SETUP &amp; OPEN TERMUX</button>
            <button class="btn" onclick="openTermuxOnly()">OPEN TERMUX</button>
          </div>
        </div>
      </div>

      <div class="stats-grid">
        <div class="stat-box">
          <span>PROJECTS</span>
          <strong id="statProjects">0</strong>
        </div>
        <div class="stat-box">
          <span>FILES</span>
          <strong id="statFiles">0</strong>
        </div>
        <div class="stat-box">
          <span>WORKER</span>
          <strong>AUTO</strong>
        </div>
      </div>

      <!-- Navigation Tabs -->
      <div class="nav-tabs">
        <button class="tab-btn active" id="tabBtn-dashboard" onclick="switchTab('dashboard')">Dashboard</button>
        <button class="tab-btn" id="tabBtn-editor" onclick="switchTab('editor', true)">Code Editor</button>
        <button class="tab-btn" id="tabBtn-upload" onclick="switchTab('upload')">Upload Files</button>
        <button class="tab-btn" id="tabBtn-worker" onclick="switchTab('worker')">Worker Setup</button>
        <button class="tab-btn" id="tabBtn-account" onclick="switchTab('account')">Account</button>
      </div>

      <!-- Dashboard Tab -->
      <div id="tab-dashboard" class="card">
        <div class="section-head">
          <h3>MY PYTHON PROJECTS</h3>
          <span>Live Link &amp; Controls</span>
        </div>
        <div id="projectList">
          <p style="font-size:12px; color:var(--muted);">লোড হচ্ছে...</p>
        </div>
      </div>

      <!-- Code Editor Tab -->
      <div id="tab-editor" class="card hidden">
        <div class="section-head">
          <h3>PYTHON CODE EDITOR</h3>
          <span>Pydroid 3 Mode</span>
        </div>
        <p style="font-size:12px; color:var(--muted); margin-bottom:6px;">
          এখানে সরাসরি নতুন Python কোড লিখুন বা পুরোনো প্রজেক্ট এডিট করে <strong>SAVE &amp; START</strong> চাপুন।
        </p>

        <label>Select Existing Project (Optional)</label>
        <select id="editorProjectSelect" onchange="loadProjectIntoEditor()">
          <option value="">+ Create New Project (Blank)</option>
        </select>

        <label>Project Name</label>
        <input type="text" id="editorProjectName" placeholder="যেমন: my_mini_bot" />

        <div class="btn-row" style="margin-top:10px; margin-bottom:2px;">
          <button class="btn" onclick="insertMiniAppTemplate()">+ Mini App Design Template বসান</button>
          <button class="btn" onclick="clearEditor()">New Blank Code</button>
        </div>

        <label>main.py (Python Code)</label>
        <div class="pro-editor">
          <div id="edGutter" class="ed-gutter"></div>
          <div class="ed-viewport">
            <div id="edHighlight" class="ed-highlight"></div>
            <textarea
              id="editorMainPy"
              class="ed-textarea"
              spellcheck="false"
              placeholder="# এখানে নতুন Python কোড লিখুন..."
              oninput="renderEditor()"
              onscroll="syncScroll()"
              onclick="updateCursorLine()"
              onkeyup="updateCursorLine()"
            ></textarea>
          </div>
        </div>

        <div class="editor-meta">
          <span id="edLineStatus" class="meta-line-badge">Line 1</span>
          <span id="edErrorStatus" class="meta-err-list">ভুল নেই</span>
        </div>

        <label>requirements.txt (Default: requests, flask)</label>
        <textarea id="editorReqTxt" class="req-area" spellcheck="false" placeholder="requests&#10;flask"></textarea>

        <div class="btn-row" style="margin-top:14px;">
          <button class="btn" style="flex:1;" onclick="saveEditorProject(false)">SAVE ONLY</button>
          <button class="btn btn-gold" style="flex:1;" onclick="saveEditorProject(true)">SAVE &amp; START</button>
        </div>
      </div>

      <!-- Upload Files Tab -->
      <div id="tab-upload" class="card hidden">
        <div class="section-head">
          <h3>UPLOAD PROJECT FILES</h3>
          <span>main.py Required</span>
        </div>
        <label>Project Name</label>
        <input type="text" id="uploadProjectName" placeholder="যেমন: telegram_bot" />

        <label>Select Files (.py, .txt, .json)</label>
        <input type="file" id="uploadFilesInput" multiple accept=".py,.txt,.json,.yaml,.yml,.ini,.md" />

        <button class="btn btn-gold" style="width:100%; margin-top:14px;" onclick="uploadProjectFiles()">
          SAVE PROJECT FILES
        </button>
      </div>

      <!-- Worker Setup Tab -->
      <div id="tab-worker" class="card hidden">
        <div class="section-head">
          <h3>TERMUX WORKER SETUP</h3>
          <span>Auto Tunnel</span>
        </div>
        <p style="font-size:12px; color:var(--muted); line-height:1.5;">
          ১. নিচের বাটনে চাপলে কমান্ড কপি হবে এবং Termux ওপেন হবে (Termux-এ পেস্ট করে Enter দিন):
        </p>
        <div class="btn-row" style="margin-top:8px;">
          <button class="btn btn-gold" onclick="copySetupAndOpenTermux()">COPY SETUP &amp; OPEN TERMUX</button>
          <button class="btn" onclick="copyText(getWorkerSetupCommand())">COPY COMMAND ONLY</button>
        </div>
        <div class="code-cmd" id="setupCmdPreview"></div>
        <p style="font-size:12px; color:var(--muted); line-height:1.5;">
          ২. এরপর Termux-এ আপনার Firebase ইমেইল ও পাসওয়ার্ড দিন।
        </p>
        <p style="font-size:12px; color:var(--muted); line-height:1.5;">
          ৩. স্ক্রিন বন্ধ থাকলেও বট চালু রাখতে Termux নোটিফিকেশন থেকে <strong>Acquire wakelock</strong> চালু রাখুন।
        </p>
      </div>

      <!-- Account Tab -->
      <div id="tab-account" class="card hidden">
        <div class="section-head">
          <h3>ACCOUNT SETTINGS</h3>
          <span>Active Session</span>
        </div>
        <p style="font-size:12.5px; color:var(--muted); margin-bottom:12px;">
          Logged in as: <strong id="userEmailLabel" style="color:var(--gold-light);">-</strong>
        </p>
        <button class="btn btn-danger" style="width:100%;" onclick="logoutUser()">LOGOUT</button>
      </div>

      <div class="footer-note">BOT HOSTING PRO • BLACK &amp; GOLD EDITION</div>
    </div>
  </div>

  <div id="toast" class="toast"></div>

  <!-- Firebase Compat SDK -->
  <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-database-compat.js"></script>

  <script>
    const firebaseConfig = {
      apiKey: "AIzaSyDFdPaMtvNcyP_ZFecXD1tKgP-XFhm6uHw",
      authDomain: "bothost-5a1e7.firebaseapp.com",
      databaseURL: "https://bothost-5a1e7-default-rtdb.firebaseio.com",
      projectId: "bothost-5a1e7",
      storageBucket: "bothost-5a1e7.firebasestorage.app"
    };

    const DEFAULT_REQUIREMENTS = "requests\nflask";

    firebase.initializeApp(firebaseConfig);
    const auth = firebase.auth();
    const db = firebase.database();

    let currentUser = null;
    let projectsCache = {};
    let activeLine = 1;

    function findErrorLines(code) {
      const lines = code.split("\n");
      const errors = new Set();

      let inMultiSingle = false;
      let inMultiDouble = false;
      let openParenLine = null;
      let parenDepth = 0;
      let openBracketLine = null;
      let bracketDepth = 0;
      let openBraceLine = null;
      let braceDepth = 0;

      for (let i = 0; i < lines.length; i++) {
        const lineNo = i + 1;
        const line = lines[i];
        const trimmed = line.trim();

        if (!trimmed || trimmed.startsWith("#")) continue;

        if (/^\s*improt\b/.test(line)) {
          errors.add(lineNo);
        }

        let inSingle = false;
        let inDouble = false;

        for (let j = 0; j < line.length; j++) {
          const ch = line[j];
          const prev = j > 0 ? line[j - 1] : "";
          const next2 = line.slice(j, j + 3);

          if (prev === "\\") continue;

          if (!inMultiDouble && !inSingle && next2 === "'''") {
            inMultiSingle = !inMultiSingle;
            j += 2;
            continue;
          }
          if (!inMultiSingle && !inSingle && next2 === '"""') {
            inMultiDouble = !inMultiDouble;
            j += 2;
            continue;
          }

          if (inMultiSingle || inMultiDouble) continue;

          if (!inDouble && ch === "'") {
            inSingle = !inSingle;
            continue;
          }
          if (!inSingle && ch === '"') {
            inDouble = !inDouble;
            continue;
          }

          if (inSingle || inDouble) continue;

          if (ch === "#") break;

          if (ch === "(") {
            if (parenDepth === 0) openParenLine = lineNo;
            parenDepth++;
          } else if (ch === ")") {
            parenDepth--;
            if (parenDepth < 0) {
              errors.add(lineNo);
              parenDepth = 0;
              openParenLine = null;
            } else if (parenDepth === 0) {
              openParenLine = null;
            }
          } else if (ch === "[") {
            if (bracketDepth === 0) openBracketLine = lineNo;
            bracketDepth++;
          } else if (ch === "]") {
            bracketDepth--;
            if (bracketDepth < 0) {
              errors.add(lineNo);
              bracketDepth = 0;
              openBracketLine = null;
            } else if (bracketDepth === 0) {
              openBracketLine = null;
            }
          } else if (ch === "{") {
            if (braceDepth === 0) openBraceLine = lineNo;
            braceDepth++;
          } else if (ch === "}") {
            braceDepth--;
            if (braceDepth < 0) {
              errors.add(lineNo);
              braceDepth = 0;
              openBraceLine = null;
            } else if (braceDepth === 0) {
              openBraceLine = null;
            }
          }
        }

        if (inSingle || inDouble) {
          errors.add(lineNo);
        }

        if (
          !inMultiSingle &&
          !inMultiDouble &&
          parenDepth === 0 &&
          bracketDepth === 0 &&
          braceDepth === 0 &&
          /^\s*(def|class|if|elif|else|for|while|try|except|finally|with)\b/.test(line)
        ) {
          const cleanPart = line.replace(/#.*$/, "").trim();
          if (!cleanPart.endsWith(":")) {
            errors.add(lineNo);
          }
        }
      }

      if (inMultiSingle || inMultiDouble) {
        errors.add(lines.length);
      }
      if (parenDepth > 0 && openParenLine) errors.add(openParenLine);
      if (bracketDepth > 0 && openBracketLine) errors.add(openBracketLine);
      if (braceDepth > 0 && openBraceLine) errors.add(openBraceLine);

      return errors;
    }

    function updateCursorLine() {
      const ta = document.getElementById("editorMainPy");
      if (!ta) return;
      const pos = ta.selectionStart || 0;
      activeLine = ta.value.slice(0, pos).split("\n").length;
